# Copy this file to `.streamlit/secrets.toml` for local use, or paste the
# same keys into the Streamlit Community Cloud "Secrets" manager for deployment.
#
# EVERY key is optional. The terminal runs without any of them, degrading
# gracefully (live feeds that need a key are marked UNAVAILABLE; the narrative
# falls back to the deterministic template engine; news falls back to the
# rule-based macro lexicon).

# Federal Reserve Economic Data — real yields, breakevens, CPI, fed funds.
# Free key: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY = ""

# Anthropic Claude — grounded narrative + news interpretation layer.
# https://console.anthropic.com/
ANTHROPIC_API_KEY = ""
# Defaults to the most capable model; set a faster/cheaper one to cut cost.
ANTHROPIC_MODEL = "claude-opus-4-8"

# NewsAPI.org — optional supplement to the (keyless) RSS news feeds.
NEWSAPI_KEY = ""

# Data mode: "auto" (live, fall back to bundled snapshot), "live", or "demo".
DATA_MODE = "auto"
